# Environment Variables Template
# Copy this file to .env.local and fill in your actual values
# NEVER commit .env.local to git!

# Resend API Key for email functionality
# Get your API key from: https://resend.com/api-keys
RESEND_API_KEY=your_api_key_here

# AI Chat & Video Generation
# OpenRouter is required for Seedance video generation.
OPENROUTER_API_KEY=your_openrouter_api_key_here

# Recommended for chat: Groq free tier (~14.4k req/day on llama-3.1-8b-instant)
# Get a key at https://console.groq.com — chat cascades Groq → Gemma → openrouter/free → others
GROQ_API_KEY=your_groq_api_key_here
# GOOGLE_GENERATIVE_AI_API_KEY=your_google_ai_key_here

# Optional: Local Ollama setup for chat (runs on your PC, needs Ollama server running)
# OLLAMA_BASE_URL=http://localhost:11434
# OLLAMA_MODEL=llama3.2:3b # Example: llama3.2:3b (requires ~4GB VRAM)

# Admin panel (change these in production!)
ADMIN_PASSWORD=dmf-admin-2026
ADMIN_SESSION_SECRET=change-this-to-a-random-secret

# Site URL (used for download links, Stripe redirects, and Supabase auth)
NEXT_PUBLIC_SITE_URL=https://damoneyfam.com

# Google Analytics 4 (optional — create at https://analytics.google.com)
NEXT_PUBLIC_GA_MEASUREMENT_ID=

# Stripe — use LIVE keys for production (https://dashboard.stripe.com/apikeys)
# Test: sk_test_ / pk_test_  |  Live: sk_live_ / pk_live_
STRIPE_SECRET_KEY=your_stripe_secret_key_here
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=your_stripe_publishable_key_here
# Live webhook: https://damoneyfam.com/api/webhooks/stripe
# Events: checkout.session.completed, customer.subscription.updated, customer.subscription.deleted
STRIPE_WEBHOOK_SECRET=your_stripe_webhook_secret_here
# Fan Club subscription ($9/mo) — create in Stripe Dashboard (live), copy price_ ID
STRIPE_FAN_CLUB_PRICE_ID=price_your_fan_club_price_id_here

# Supabase (required for fan login, favorites, library sync)
# Create a project at https://supabase.com, run supabase/schema.sql, enable Email + Google auth
# Set redirect URL to {SITE_URL}/auth/callback in Supabase Dashboard
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Jackpotwrld Kickstarter campaign URL (when live)
NEXT_PUBLIC_KICKSTARTER_URL=

# Blog ingest — generate: [Convert]::ToBase64String((1..32|%{Get-Random -Max 256}) -as [byte[]])
# n8n header: Authorization: Bearer <secret>
N8N_BLOG_INGEST_SECRET=
