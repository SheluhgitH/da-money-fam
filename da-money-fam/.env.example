# Environment Variables Template
# Copy this file to .env.local and fill in your actual values
# NEVER commit .env.local to git!

# Resend API Key for email functionality
# Get your API key from: https://resend.com/api-keys
RESEND_API_KEY=your_api_key_here
OPENROUTER_API_KEY=your_openrouter_api_key_here

# Admin panel (change these in production!)
ADMIN_PASSWORD=dmf-admin-2026
ADMIN_SESSION_SECRET=change-this-to-a-random-secret

# Site URL (used for download links, Stripe redirects, and Supabase auth)
NEXT_PUBLIC_SITE_URL=https://damoneyfam.com

# Google Analytics 4 (optional — create at https://analytics.google.com)
NEXT_PUBLIC_GA_MEASUREMENT_ID=

# Stripe — use LIVE keys for production (https://dashboard.stripe.com/apikeys)
# Test: sk_test_ / pk_test_  |  Live: sk_live_ / pk_live_
STRIPE_SECRET_KEY=your_stripe_secret_key_here
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=your_stripe_publishable_key_here
# Live webhook: https://damoneyfam.com/api/webhooks/stripe (event: checkout.session.completed)
STRIPE_WEBHOOK_SECRET=your_stripe_webhook_secret_here

# Supabase (required for fan login, favorites, library sync)
# Create a project at https://supabase.com, run supabase/schema.sql, enable Email + Google auth
# Set redirect URL to {SITE_URL}/auth/callback in Supabase Dashboard
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
